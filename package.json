{
	"name": "dates-le",
	"publisher": "nolindnaidoo",
	"displayName": "Dates-LE",
	"description": "Zero Hassle Date/Time Extraction and Analysis from Logs, Configs, and Code",
	"version": "2.0.1",
	"license": "MIT",
	"author": {
		"name": "nolindnaidoo",
		"url": "https://github.com/nolindnaidoo"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/nolindnaidoo/dates-le.git"
	},
	"bugs": {
		"url": "https://github.com/nolindnaidoo/dates-le/issues"
	},
	"homepage": "https://letools.dev",
	"engines": {
		"vscode": "^1.90.0",
		"node": ">=20.0.0"
	},
	"categories": [
		"Data Science",
		"Programming Languages",
		"Linters"
	],
	"keywords": [
		"dates",
		"date",
		"time",
		"datetime",
		"timestamp",
		"extract",
		"extractor",
		"extraction",
		"log",
		"logs",
		"log-analysis",
		"log-parsing",
		"observability",
		"iso-8601",
		"rfc-2822",
		"unix-timestamp",
		"epoch",
		"epoch-converter",
		"timezone",
		"moment",
		"dayjs",
		"date-parser",
		"conversion",
		"validation",
		"analysis",
		"audit",
		"json",
		"yaml",
		"csv",
		"xml"
	],
	"icon": "src/assets/images/icon.png",
	"main": "./dist/extension.js",
	"activationEvents": [
		"onLanguage:json",
		"onLanguage:yaml",
		"onLanguage:yml",
		"onLanguage:csv",
		"onLanguage:xml",
		"onLanguage:javascript",
		"onLanguage:typescript",
		"onLanguage:typescriptreact",
		"onLanguage:javascriptreact",
		"onLanguage:html",
		"onLanguage:log",
		"onLanguage:plaintext"
	],
	"capabilities": {
		"virtualWorkspaces": {
			"supported": "limited",
			"description": "%manifest.capability.untrusted-workspaces.desc%"
		},
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "%manifest.capability.untrusted-workspaces.desc%"
		}
	},
	"contributes": {
		"commands": [
			{
				"command": "dates-le.extractDates",
				"title": "%manifest.command.extract.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "dates-le.postProcess.dedupe",
				"title": "%manifest.command.dedupe.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "dates-le.postProcess.sort",
				"title": "%manifest.command.sort.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "dates-le.openSettings",
				"title": "%manifest.command.settings.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "dates-le.analyze",
				"title": "%manifest.command.analyze.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "dates-le.convert",
				"title": "%manifest.command.convert.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "dates-le.filter",
				"title": "%manifest.command.filter.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "dates-le.validate",
				"title": "%manifest.command.validate.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "dates-le.help",
				"title": "%manifest.command.help.title%",
				"category": "%manifest.command.category%"
			}
		],
		"keybindings": [
			{
				"command": "dates-le.extractDates",
				"key": "ctrl+alt+d",
				"mac": "cmd+alt+d",
				"when": "editorTextFocus"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "dates-le.extractDates",
					"when": "editorLangId =~ /^(json|yaml|yml|csv|xml|javascript|javascriptreact|typescript|typescriptreact|html|log|plaintext)$/",
					"group": "1_modification@1"
				}
			],
			"commandPalette": [
				{
					"command": "dates-le.extractDates"
				},
				{
					"command": "dates-le.postProcess.dedupe"
				},
				{
					"command": "dates-le.postProcess.sort"
				},
				{
					"command": "dates-le.analyze"
				},
				{
					"command": "dates-le.convert"
				},
				{
					"command": "dates-le.filter"
				},
				{
					"command": "dates-le.validate"
				},
				{
					"command": "dates-le.openSettings"
				},
				{
					"command": "dates-le.help"
				}
			]
		},
		"configuration": {
			"title": "%manifest.settings.title%",
			"properties": {
				"dates-le.copyToClipboardEnabled": {
					"type": "boolean",
					"default": false,
					"description": "%manifest.settings.copy.clipboard.desc%"
				},
				"dates-le.notificationsLevel": {
					"type": "string",
					"default": "silent",
					"enum": [
						"all",
						"important",
						"silent"
					],
					"enumDescriptions": [
						"%manifest.settings.notifications.level.option.all%",
						"%manifest.settings.notifications.level.option.important%",
						"%manifest.settings.notifications.level.option.silent%"
					],
					"description": "%manifest.settings.notifications.level.desc%"
				},
				"dates-le.openResultsSideBySide": {
					"type": "boolean",
					"default": true,
					"description": "%manifest.settings.open.side-by-side.desc%"
				},
				"dates-le.safety.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%manifest.settings.safety.enabled.desc%"
				},
				"dates-le.safety.fileSizeWarnBytes": {
					"type": "number",
					"default": 1e6,
					"minimum": 1000,
					"description": "%manifest.settings.safety.warn.file-size.desc%"
				},
				"dates-le.statusBar.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%manifest.settings.statusbar.enabled.desc%"
				},
				"dates-le.telemetryEnabled": {
					"type": "boolean",
					"default": false,
					"description": "%manifest.settings.telemetry.desc%"
				}
			}
		}
	},
	"scripts": {
		"clean": "node -e \"const fs=require('fs');['dist','coverage','release'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
		"clean:i18n": "node -e \"const fs=require('fs');fs.readdirSync('.').filter(f=>f.startsWith('package.nls.')&&f.endsWith('.json')&&f!=='package.nls.json').forEach(f=>fs.unlinkSync(f))\"",
		"copy:i18n": "node -e \"const fs=require('fs');fs.readdirSync('src/i18n').forEach(f=>fs.copyFileSync('src/i18n/'+f,f))\"",
		"build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --main-fields=module,main --sourcemap",
		"build:prod": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --main-fields=module,main --minify --sourcemap=external",
		"watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --main-fields=module,main --sourcemap --watch",
		"typecheck": "tsc --noEmit",
		"check:bundle": "node scripts/check-bundle.js",
		"test": "TZ=UTC vitest run --pool=threads",
		"test:watch": "TZ=UTC vitest --pool=threads",
		"test:coverage": "TZ=UTC vitest run --coverage --pool=threads",
		"coverage:readme": "node scripts/coverage-readme.js",
		"coverage:readme:check": "node scripts/coverage-readme.js --check",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"vscode:prepublish": "npm run typecheck && npm run build:prod && npm run check:bundle && npm run copy:i18n",
		"package": "node -e \"require('fs').mkdirSync('release',{recursive:true})\" && vsce package --no-dependencies --out release/ && npm run clean:i18n",
		"publish": "vsce publish",
		"test:integration": "npm run build && tsc -p tsconfig.it.json && vscode-test",
		"test:e2e-vsix": "node scripts/e2e-vsix.js"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.1.2",
		"@types/vscode": "1.90.0",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "^0.28.1",
		"mocha": "^11.8.0",
		"ovsx": "^1.1.0",
		"tsx": "^4.23.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
